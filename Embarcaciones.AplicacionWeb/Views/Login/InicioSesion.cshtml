@using Embarcaciones.AplicacionWeb.Models.ViewModels.Seguridad;
@using Embarcaciones.AplicacionWeb.Models.Utils
@model InicioSesionVM

@{
    Layout = null;
}
<header>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="styleLoginBootstrap.css" />
    <link href="~/css/seguridad/iniciosesion.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>

        #notifications {
            cursor: pointer;
            position: fixed;
            right: 0px;
            z-index: 9999;
            top: 65px;
            margin-bottom: 0px;
            margin-right: 0px;
            max-width: 500px;
            width: 100%;
            padding: 0px 15px;
            bottom: unset;
        }

        .custom-alert {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 10px;
            font-size: 14px;
            position: relative;
        }

            /* ERROR (rojo suave) */
            .custom-alert.alert-danger {
                background-color: #ff9aa2;
                color: #7a0c12;
            }

            /* INFO */
            .custom-alert.alert-info {
                background-color: #bde5f8;
                color: #055160;
            }

            /* SUCCESS */
            .custom-alert.alert-success {
                background-color: #b7f0c1;
                color: #0f5132;
            }

            /* WARNING */
            .custom-alert.alert-warning {
                background-color: #fff3cd;
                color: #664d03;
            }

        .alert-icon {
            font-size: 18px;
            margin-right: 12px;
        }

        .alert-text {
            flex: 1;
            font-weight: 500;
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: inherit;
        }

        #contenedor-imagen{
            width: 230px;
            height: 230px;
            margin-left: 100px;
            margin-top: 40px;   
        }
    </style>
</header>
<div id="notifications"></div>
<section class="vh-100">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col col-xl-10">
                <div class="card" style="border-radius: 1rem;">
                    <div class="row g-0">
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <div id="contenedor-imagen">
                                <img src="~/images/MarinaNicaragua.png" alt="login form" class="img-fluid"
                                     style="border-radius: 1rem 0 0 1rem;" />
                            </div>
                            <div id="contenedor-texto" style="margin-top:55px;">
                                <h2>SIEB</h2>
                                <p>
                                    ¡Bienvenido al Sistema de Embarcaciones!
                                    Por favor, ingresa tus credenciales para acceder a la plataforma que te permitirá
                                    gestionar el Control de Embarcaciones
                                </p>

                            </div>
                        </div>
                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                <form asp-controller="Login" asp-action="InicioSesion" method="post">

                                    <div class="d-flex align-items-center mb-3 pb-1">
                                        <i class="fa fa-user-circle fa-2x me-3" style="color: #0d00b9;"></i>
                                        <span class="h1 fw-bold mb-0" style="color: #0d00b9;">Inicio Sesión</span>
                                    </div>
                                    <div class="input-group flex-nowrap  mb-4">

                                        <span class="input-group-text" id="addon-wrapping"><i class="fa fa-user"></i></span>
                                        <input type="text" class="form-control" placeholder="Cuenta" aria-label="Username" asp-for="Cuenta" aria-describedby="addon-wrapping">
                                    </div>

                                    <div class="input-group flex-nowrap  mb-4">

                                        <span class="input-group-text" id="addon-wrapping"><i class="fa fa-keyboard"></i></span>
                                        <input type="password" class="form-control" placeholder="Contraseña" asp-for="Clave" aria-label="Clave" aria-describedby="addon-wrapping">
                                        <span class="input-group-text"
                                              style="cursor:pointer"
                                              onclick="togglePassword()">
                                            <i id="icon-password" class="fas fa-eye"></i>
                                        </span>

                                    </div>


                                    <div class="pt-1 mb-4 d-flex justify-content-center">
                                        <button class="btn btn-primary btn-lg btn-block">
                                            <i class="fas fa-sign-in-alt"></i>
                                            Ingresar
                                        </button>
                                    </div>

                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center mt-4">
        <p class="small text-muted"> Todos los derechos reservados 2026©.</p>
    </footer>
    <script src="~/js/scripts.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>

        @{
            var msjError = TempData.Peek(Notificacion.Error)?.ToString() ?? string.Empty;
            var msjInfo = TempData.Peek(Notificacion.Info)?.ToString() ?? string.Empty;
            var msjExito = TempData.Peek(Notificacion.Exito)?.ToString() ?? string.Empty;
            var msjAdvertencia = TempData.Peek(Notificacion.Advertencia)?.ToString() ?? string.Empty;

            TempData.Clear();
        }

            showMessages('@msjError', '@msjInfo', '@msjExito', '@msjAdvertencia');
        function togglePassword() {
            const input = document.getElementById("Clave");
            const icon = document.getElementById("icon-password");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.replace("fa-eye", "fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.replace("fa-eye-slash", "fa-eye");
            }
        }
    </script>
</section>