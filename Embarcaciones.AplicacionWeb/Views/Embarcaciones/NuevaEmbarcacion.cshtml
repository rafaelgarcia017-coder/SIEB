@using Embarcaciones.AplicacionWeb.Models.ViewModels.Procesos.Embarcaciones;

@model EmbarcacionesVM

@{
    ViewData["Title"] = "Nueva Embarcacion";
    ViewBag.Accion = @Model.Accion;
}

<style>
    /* ===== ACCORDION PROFESIONAL ===== */

    #formAccordion .accordion-item {
        border: none;
        border-radius: 10px;
        margin-bottom: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    #formAccordion .accordion-button {
        font-weight: 600;
        font-size: 15px;
        padding: 14px 20px;
    }

        #formAccordion .accordion-button:focus {
            box-shadow: none;
        }

    #formAccordion .accordion-body {
        background: #f8f9fa;
        border-top: 1px solid #eee;
    }

    /*     #formAccordion .accordion-button::after {
                                                                                                    filter: invert(1);
                                                                                                    transition: transform .3s ease;
                                                                                                }

                                                                                                #formAccordion .accordion-button:not(.collapsed)::after {
                                                                                                    transform: rotate(180deg);
                                                                                                } */

    /* animación suave */

    #formAccordion .accordion-collapse {
        transition: all .3s ease;
    }

    /* icono dinámico */

    #formAccordion .icono {
        font-size: 18px;
        font-weight: bold;
        margin-right: 8px;
    }

    .img-preview {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border: 2px dashed #ccc; /* borde punteado */
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
    }

        /* efecto al pasar el mouse */
        .img-preview:hover {
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
            transform: scale(1.03);
            border-color: #007bff; /* cambia color del borde */
        }



    .contenedor-imagen {
        position: relative;
        display: inline-block;
    }

    .btn-eliminar {
        position: absolute;
        top: 5px;
        right: 5px;
        background-color: rgba(0, 0, 0, 0.6);
        color: white;
        border: none;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        cursor: pointer;
        opacity: 0; /* oculto por defecto */
        transition: all 0.3s ease;
    }

    /* aparece al pasar el mouse */
    .contenedor-imagen:hover .btn-eliminar {
        opacity: 1;
    }

    /* efecto hover del botón */
    .btn-eliminar:hover {
        transform: scale(1.1);
    }
</style>


