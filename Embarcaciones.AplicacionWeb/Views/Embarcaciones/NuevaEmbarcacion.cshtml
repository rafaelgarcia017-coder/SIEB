}
@section scripts
{
          <script type="text/javascript">
            $(document).ready(function () {

                $('.cmb').select2({
                    placeholder: "Seleccione...",
                    allowClear: true,
                    width: '100%' // hace que ocupe todo el ancho del contenedor
                });

            /* ===== ICONO DINAMICO ACCORDION ===== */

            $('#formAccordion').on('show.bs.collapse', function (e) {

                $(e.target)
                    .prev('.accordion-header')
                    .find('.icono')
                    .text('-');

            });

            $('#formAccordion').on('hide.bs.collapse', function (e) {

                $(e.target)
                    .prev('.accordion-header')
                    .find('.icono')
                    .text('+');

            });

        @foreach (var field in ViewData.ModelState)
        {
            if (field.Value.Errors.Count > 0)
            {
                <text>
                                        var input = $('[name="@field.Key"]');

                                        // Para inputs normales
                                        if (!input.hasClass('select2-hidden-accessible')) {
                                            input.addClass('is-invalid');
                                                        }

                                        // Para Select2
                                        if (input.hasClass('select2-hidden-accessible')) {
                                            // agrega is-invalid al contenedor visible de Select2
                                            input.next('.select2-container')
                                                .find('.select2-selection')
                                                .addClass('is-invalid');
                                                        }
                </text>
            }
        }
                    });
        document.getElementById("ImagenFile").addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("preview").src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>


}
  