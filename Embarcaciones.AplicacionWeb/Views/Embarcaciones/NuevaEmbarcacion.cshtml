@using Embarcaciones.AplicacionWeb.Models.ViewModels.Procesos.Embarcaciones;

@model EmbarcacionesVM

@{
    ViewData["Title"] = "Nueva Embarcacion";
    ViewBag.Accion = @Model.Accion;
}

<style>
    .contenedor-imagen {
        width: 200px;
        height: 200px;
        position: relative;
        border: 2px dashed #ccc;
        border-radius: 10px; /* Bordes suaves */
        overflow: hidden;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa;
    }

        .contenedor-imagen:hover {
            border-color: #007bff;
            background-color: #e9ecef;
        }

    .img-preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>


<form>
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex justify-content-end">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">SIEB</li>
                                <li class="breadcrumb-item active" aria-current="page">Embarcacion</li>
                                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Embarcacion</li>
                                <input type="hidden" asp-for="EmbarcacionPropietario.EmpresaPropietario" />
                                <input type="hidden" asp-for="Accion" id="hd-accion" />
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">


                        <div class="card shadow border-0">
                            <div class="card-header bg-info text-white">
                                <h4 class="mb-0">Registro de Embarcación</h4>
                            </div>

                            <div class="card-body">

                                <div class="accordion" id="formAccordion">
                                    <!-- 👤 DATOS PROPIETARIO (Cerrado) -->
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button fw-semibold bg-primary text-white"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseTwo">
                                                👤 Datos del Propietario
                                            </button>
                                        </h2>

                                        <div id="collapseTwo" class="accordion-collapse collapse show">
                                            <div class="accordion-body">
                                                <div class="row g-3">
                                                    <div class="col-md-3">
                                                        <label class="form-label">Nombre Completo:</label>
                                                        <input asp-for="EmbarcacionPropietario.NombreCompleto" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Tipo Identificacion:</label>                      
                                                        <select asp-for="EmbarcacionPropietario.TipoIdentificacion"
                                                                asp-items="Model.EmbarcacionPropietario.ListaTipoIdentificacion"
                                                                class="form-select" id="cmb-tipo-identificacion">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Identificacion:</label>
                                                        <input asp-for="EmbarcacionPropietario.Identificacion" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Nacionalidad:</label>                                                       
                                                        <select asp-for="EmbarcacionPropietario.Nacionalidad"
                                                                asp-items="Model.EmbarcacionPropietario.ListaNacionalidad"
                                                                class="form-select" id="cmb-nacionalidad">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Telefono:</label>
                                                        <input asp-for="EmbarcacionPropietario.Telefono" class="form-control" />
                                                    </div>

                                                    <!-- Tercera fila -->
                                                    <div class="col-md-3">                                                 
                                                        <label class="form-label">Departamento:</label>
                                                        <select asp-for="EmbarcacionPropietario.Departamento"
                                                                asp-items="Model.EmbarcacionPropietario.ListaDepartamentos"
                                                                class="form-select" id="cmb-departamentos">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Municipio:</label>
                                                        <select asp-for="EmbarcacionPropietario.Municipio"
                                                                asp-items="Model.EmbarcacionPropietario.ListaMunicipio"
                                                                class="form-select" id="cmb-municipio">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Licencia Navegacion:</label>
                                                        <input asp-for="EmbarcacionPropietario.LicenciaNavegacion" class="form-control" />
                                                    </div>

                                                    <!-- Cuarta fila -->
                                                    <div class="col-md-3 ">
                                                        <label class="form-label">Nombre Contacto:</label>
                                                        <input asp-for="EmbarcacionPropietario.NombreContacto" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">N° Carnet:</label>
                                                        <input asp-for="EmbarcacionPropietario.NumeroCarnetMarinero" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Empresa:</label>
                                                        <input asp-for="EmbarcacionPropietario.EmpresaPropietario" class="form-control" />
                                                    </div>

                                                    <!-- Quinta fila -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">Telefono:</label>
                                                        <input asp-for="EmbarcacionPropietario.TelefonoContacto" class="form-control" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Observaciones:</label>
                                                        <textarea asp-for="EmbarcacionPropietario.Observaciones" class="form-control" rows="5"></textarea>
                                                    </div>
                                                    <div class="col-md-3 d-flex justify-content-center align-items-center">
                                                        <!-- Aquí va la imagen -->
                                                        <div class="contenedor-imagen">
                                                            <label for="ImagenFile" style="cursor:pointer;">
                                                                <img id="preview"
                                                                     src="@(string.IsNullOrEmpty(Model?.EmbarcacionPropietario.UrlImagen) ? "~/images/placeholder.png" : Url.Content(Model.EmbarcacionPropietario.UrlImagen))"
                                                                     class="img-preview" />
                                                            </label>
                                                            <input asp-for="EmbarcacionPropietario.ImagenFile"
                                                                   type="file"
                                                                   id="ImagenFile"
                                                                   accept="image/*"
                                                                   style="display:none;" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 🚤 DATOS EMBARCACIÓN (Abierto) -->
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed fw-semibold bg-success text-white bg-opacity-75"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseOne">
                                                🚤 Datos de la Embarcación
                                            </button>
                                        </h2>

                                        <div id="collapseOne" class="accordion-collapse collapse">
                                            <div class="accordion-body">
                                                <div class="row g-3">
                                                    <div class="col-md-3">
                                                        <label class="form-label">Matricula:</label>
                                                        <input asp-for="DatosEmbarcaciones.MatriculaActual" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Tipo Embarcacion:</label>
                                                        <select asp-for="DatosEmbarcaciones.TipoEmbarcacion"
                                                                asp-items="Model.DatosEmbarcaciones.ListaTipoEmbarcacion"
                                                                class="form-select" id="cmb-tipo-identificacion">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label"> Matricula Anterior:</label>
                                                        <input asp-for="DatosEmbarcaciones.MatriculaAnterior" class="form-control" />
                                                    </div>


                                                    <div class="col-md-3">
                                                        <label class="form-label"> Nombre:</label>
                                                        <input asp-for="DatosEmbarcaciones.NombreActual" class="form-control" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">OMI:</label>
                                                        <input asp-for="DatosEmbarcaciones.NumeroOmi" class="form-control" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Propietario Anterior:</label>
                                                        <input asp-for="DatosEmbarcaciones.PropietarioAnterior " class="form-control" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Indicativo LLamada:</label>
                                                        <input asp-for="DatosEmbarcaciones.IndicativoLLamada " class="form-control" />
                                                    </div>

                                                    <!-- Tercera fila -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">Puerto:</label>
                                                        <select asp-for="DatosEmbarcaciones.PuertoRegistroActual"
                                                                asp-items="Model.DatosEmbarcaciones.ListaPuertoRegistroActual"
                                                                class="form-select" id="cmb-departamentos">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Fecha Abanderamiento:</label>
                                                        <input asp-for="DatosEmbarcaciones.FechaAbanderamiento " class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Bandera:</label>
                                                        <select asp-for="DatosEmbarcaciones.BanderaActual"
                                                                asp-items="Model.DatosEmbarcaciones.ListaBanderaActual"
                                                                class="form-select" id="cmb-departamentos">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Bandera Anterior:</label>
                                                        <select asp-for="DatosEmbarcaciones.BanderaAnterior"
                                                                asp-items="Model.DatosEmbarcaciones.ListaBanderaAnterior"
                                                                class="form-select" id="cmb-municipio">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Fecha Expiracion:</label>
                                                        <input asp-for="DatosEmbarcaciones.FechaExpiracion" class="form-control" />
                                                    </div>

                                                    <!-- Cuarta fila -->
                                                    <div class="col-md-3 ">
                                                        <label class="form-label">Permiso Navegacion:</label>
                                                        <input asp-for="DatosEmbarcaciones.PermisoNavegacion" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Fecha Expiracion:</label>
                                                        <input asp-for="DatosEmbarcaciones.FechaExpiracion" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Licencia Pesca:</label>
                                                        <input asp-for="DatosEmbarcaciones.LicenciaPesca" class="form-control" />
                                                    </div>

                                                    <!-- Quinta fila -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">Lic. Especial Pesca:</label>
                                                        <input asp-for="DatosEmbarcaciones.LicenciaEspecialPesca" class="form-control" />
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Actividad:</label>
                                                        <select asp-for="DatosEmbarcaciones.Actividad"
                                                                asp-items="Model.DatosEmbarcaciones.ListaActividad"
                                                                class="form-select" id="cmb-municipio">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Zona Navegacion:</label>
                                                        <select asp-for="DatosEmbarcaciones.ZonaNavegacion"
                                                                asp-items="Model.DatosEmbarcaciones.ListaZonaNavegacion"
                                                                class="form-select" id="cmb-municipio">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Distrito:</label>
                                                        <input asp-for="DatosEmbarcaciones.Distrito" class="form-control" />
                                                    </div>

                                                    <!-- Quinta fila -->
                                                    <div class="col-md-3">
                                                        <label class="form-label">CAP/PCE:</label>
                                                        <input asp-for="DatosEmbarcaciones.Cap_Pce" class="form-control" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Observaciones:</label>
                                                        <textarea asp-for="DatosEmbarcaciones.Observaciones" class="form-control" rows="5"></textarea>
                                                    </div>
                                                    <div class="col-md-3 d-flex justify-content-center align-items-center">
                                                        <!-- Aquí va la imagen -->
                                                        <div class="contenedor-imagen">
                                                            <label for="ImagenFile" style="cursor:pointer;">
                                                                <img id="preview"
                                                                     src="@(string.IsNullOrEmpty(Model?.DatosEmbarcaciones.UrlImagen) ? "~/images/placeholder.png" : Url.Content(Model.DatosEmbarcaciones.UrlImagen))"
                                                                     class="img-preview" />
                                                            </label>
                                                            <input asp-for="DatosEmbarcaciones.ImagenFile"
                                                                   type="file"
                                                                   id="ImagenFile"
                                                                   accept="image/*"
                                                                   style="display:none;" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- 🏗 DATOS CONSTRUCCIÓN (Cerrado) -->
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed fw-semibold bg-secondary text-white bg-opacity-75"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapseThree">
                                                🏗 Datos de Construcción
                                            </button>
                                        </h2>

                                        <div id="collapseThree" class="accordion-collapse collapse">
                                            <div class="accordion-body">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Astillero</label>
                                                        <input type="text" class="form-control">
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Material</label>
                                                        <input type="text" class="form-control">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="mt-4 text-center    ">
                                    <button class="btn btn-success"><i class="fa fa-save"></i> Guardar</button>
                                    <a href="@Url.Action("Administrar", "Embarcaciones")" class="btn btn-danger ms-2">
                                        <i class="fa fa-times"></i> Cancelar
                                    </a>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>
<script>
    document.getElementById("ImagenFile").addEventListener("change", function (event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            document.getElementById("preview").src = e.target.result;
        };
        reader.readAsDataURL(file);
    });
</script>

