@using Embarcaciones.AplicacionWeb.Models.ViewModels.Procesos.Embarcaciones;

@model EmbarcacionesVM

@{
    ViewData["Title"] = "Nueva Embarcacion";
    ViewBag.Accion = @Model.Accion;
}

<style>
    /* ===== ACCORDION PROFESIONAL ===== */

    #formAccordion .accordion-item {
        border: none;
        border-radius: 10px;
        margin-bottom: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    #formAccordion .accordion-button {
        font-weight: 600;
        font-size: 15px;
        padding: 14px 20px;
    }

        #formAccordion .accordion-button:focus {
            box-shadow: none;
        }

    #formAccordion .accordion-body {
        background: #f8f9fa;
        border-top: 1px solid #eee;
    }

/*     #formAccordion .accordion-button::after {
        filter: invert(1);
        transition: transform .3s ease;
    }

    #formAccordion .accordion-button:not(.collapsed)::after {
        transform: rotate(180deg);
    } */

    /* animación suave */

    #formAccordion .accordion-collapse {
        transition: all .3s ease;
    }

    /* icono dinámico */

    #formAccordion .icono {
        font-size: 18px;
        font-weight: bold;
        margin-right: 8px;
    }
</style>


