                                                        <input asp-for="Construccion.MedioCx" class="form-control" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Frecuencia:</label>
                                                        <input asp-for="Construccion.Frecuencia" class="form-control" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Indicativo:</label>
                                                        <input asp-for="Construccion.Indicativo" class="form-control" />
                                                    </div>
                                                    <div class="col-md-1    ">
                                                        <label class="form-label">N° Tripulantes:</label>
                                                        <input asp-for="Construccion.NumeroTripulantes" class="form-control" />
                                                    </div>
                                                    <div class="col-md-1">
                                                        <label class="form-label">N° Pasajeros:</label>
                                                        <input asp-for="Construccion.NumeroPasajeros" class="form-control" />
                                                    </div>
                                                    <div class="col-md-1">
                                                        <label class="form-label">Cap. Carga:</label>
                                                        <input asp-for="Construccion.CapacidadCarga" class="form-control" />
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <label class="form-label">Ultimo Puerto Visitado:</label>
                                                        <select asp-for="Construccion.PuertoVisitado"
                                                                asp-items="Model.Construccion.ListaPuerto"
                                                                class="form-select cmb" id="cmb-puerto-visitado">
                                                            <option value=""></option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Tipo y Fechas de Infracciones:</label>
                                                        <textarea asp-for="Construccion.TipoFechasInfracciones" class="form-control" rows="5"></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

}
@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {

            $('.cmb').select2({
                placeholder: "Seleccione...",
                allowClear: true,
                width: '100%' // hace que ocupe todo el ancho del contenedor
            });

            /* ===== ICONO DINAMICO ACCORDION ===== */

            $('#formAccordion').on('show.bs.collapse', function (e) {

                $(e.target)
                    .prev('.accordion-header')
                    .find('.icono')
                    .text('-');

            });

            $('#formAccordion').on('hide.bs.collapse', function (e) {

                $(e.target)
                    .prev('.accordion-header')
                    .find('.icono')
                    .text('+');

            });

        });

        document.getElementById("image-file-propietario").addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("preview-propietario").src = e.target.result;
            };
            reader.readAsDataURL(file);
        });

        document.getElementById("image-file-embarcacion").addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("preview-embarcacion").src = e.target.result;
            };
            reader.readAsDataURL(file);
        });

        function eliminarImagenPropietario() {
            const preview = document.getElementById('preview-propietario');
            const input = document.getElementById('image-file-propietario');

            // Poner imagen placeholder
            preview.src = '/images/user.png';

            // Limpiar input file
            input.value = '';

            // Opcional: marcar que se eliminó (para backend)
            let eliminado = document.getElementById('ImagenEliminada');
            if (eliminado) {
                eliminado.value = "true";
            }
        }

        function eliminarImagenEmbarcacion() {
            const preview = document.getElementById('preview-embarcacion');
            const input = document.getElementById('image-file-embarcacion');

            // Poner imagen placeholder
            preview.src = '/images/ship.png';

            // Limpiar input file
            input.value = '';

            // Opcional: marcar que se eliminó (para backend)
            let eliminado = document.getElementById('ImagenEliminada');
            if (eliminado) {
                eliminado.value = "true";
            }
        }

    </script>


}
