@using Embarcaciones.AplicacionWeb.Models.Utils

@{
    ViewData["Title"] = "Pagina Principal";
    var isLoggedIn = User?.Identity?.IsAuthenticated ?? false;
    var userName = User?.Identity?.Name ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.14.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.bootstrap5.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="~/css/MenuPrincipal.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title>@ViewData["SIEB"]</title>
</head>
<body>

    <!-- Header / Navbar -->
    <header class="navbar">
        <div class="logo_item">
            <i class="fas fa-bars" id="sidebarOpen"></i>
            SIEB
        </div>
        <div class="logo_item">
            <span>SISTEMA DE EMBARCACIONES</span>
        </div>

        <div class="navbar_content">
            <i class='fas fa-sun' id="darkLight"></i>

            @if (isLoggedIn)
            {
                <div class="user_info">
                    <i class='fas fa-user'></i>
                    <span>@userName</span>
                </div>

                <a  id="btn-cerrar-sesion" asp-controller="Login" asp-action="CerrarSesion" class="btn btn-primary">
                    <i class='fas fa-sign-out-alt text-white' title="Cerrar Sesion"></i> Cerrar Sesion
                </a>
            }
        </div>
    </header>

    <!-- Layout: Sidebar + Main -->
    <div class="layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="menu_content">
                <ul class="menu_items">
                    <!-- Catalogos -->
                    <li class="item">
                        <div class="nav_link submenu_item">
                            <span class="navlink_icon">
                                <i class="fas fa-th-large"></i>
                            </span>
                            <span class="navlink">Catalogos</span>
                            <i class="fas fa-chevron-right arrow-left"></i>
                        </div>
                        <ul class="menu_items submenu">
                            <a class="nav_link sublink" asp-controller="Actividad" asp-action="Administrar">
                                <i class='fas fa-life-ring'></i> <span class="m-2">Actividad</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Bandera" asp-action="Administrar">
                                <i class='fas fa-flag'></i> <span class="m-2">Banderas</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Color" asp-action="Administrar">
                                <i class='fas fa-palette'></i> <span class="m-2">Color</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Departamento" asp-action="Administrar">
                                <i class='fas fa-map'></i> <span class="m-2">Departamentos</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Marca" asp-action="Administrar">
                                <i class='fas fa-tag'></i> <span class="m-2">Marca</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Material" asp-action="Administrar">
                                <i class='fas fa-boxes'></i> <span class="m-2">Material</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Municipio" asp-action="Administrar">
                                <i class='fas fa-map-marker-alt'></i> <span class="m-2">Municipios</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Persona" asp-action="Administrar">
                                <i class='fas fa-user'></i> <span class="m-2">Personas</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="Puerto" asp-action="Administrar">
                                <i class='fas fa-anchor'></i> <span class="m-2">Puertos</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="SistemaNavegacion" asp-action="Administrar">
                                <i class='fas fa-satellite-dish'></i> <span class="m-2">Sistema Navegacion</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="TipoIdentificacion" asp-action="Administrar">
                                <i class='fas fa-address-card'></i> <span class="m-2">Tipo Identificacion</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="TipoPropulsion" asp-action="Administrar">
                                <i class='fas fa-cogs'></i> <span class="m-2">Tipo de Propulsión</span>
                            </a>
                            <a class="nav_link sublink" asp-controller="ZonaNavegacion" asp-action="Administrar">
                                <i class='fas fa-compass'></i> <span class="m-2">Zona Navegacion</span>
                            </a>
                        </ul>

                    </li>

                    <!-- Procesos -->
                    <li class="item">
                        <div class="nav_link submenu_item">
                            <span class="navlink_icon">
                                <i class="fas fa-cog"></i>
                            </span>
                            <span class="navlink">Procesos</span>
                            <i class="fas fa-chevron-right arrow-left"></i>
                        </div>
                        <ul class="menu_items submenu">
                            <a href="#" class="nav_link sublink"><i class='fas fa-ship'></i> Embarcaciones</a>
                        </ul>
                    </li>
                </ul>

                <!-- Sidebar expand/collapse -->
                <div class="bottom_content">
                    <div class="bottom expand_sidebar">
                        <i class='fa fa-bars'></i>
                    </div>
                    <div class="bottom collapse_sidebar">
                        <i class='fa fa-bars'></i>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <main class="main">
            <div id="notifications"></div>
            @RenderBody()
          
        </main>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.blockUI/2.70/jquery.blockUI.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
        <script src="https://cdn.datatables.net/2.3.7/js/dataTables.bootstrap5.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script src="~/js/scripts.js"></script>
        @RenderSection("scripts", required: false)
        <script type="text/javascript">
            @{
                var msjError = TempData.Peek(Notificacion.Error)?.ToString() ?? string.Empty;
                var msjInfo = TempData.Peek(Notificacion.Info)?.ToString() ?? string.Empty;
                var msjExito = TempData.Peek(Notificacion.Exito)?.ToString() ?? string.Empty;
                var msjAdvertencia = TempData.Peek(Notificacion.Advertencia)?.ToString() ?? string.Empty;

                TempData.Clear();
            }

                showMessages('@msjError', '@msjInfo', '@msjExito', '@msjAdvertencia');
            $(document).ready(function () {
                $("form").on('submit', function () {
                    if ($('.blockUI.blockOverlay').length < 1) {
                        BlockUI('Procesando...');

                    }
                });
            })

        </script>
    </div>


</body>
</html>
