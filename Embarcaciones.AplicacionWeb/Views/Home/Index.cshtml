@section scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(function () {

            // 🔢 KPIs (simulado - luego lo conectas a backend)
            $("#totalEmbarcaciones").text(120);
            $("#totalPersonas").text(340);
            $("#totalPuertos").text(25);
            $("#totalNacionalidades").text(12);

            // 📊 Gráfica 1
            new Chart(document.getElementById('chartTipos'), {
                type: 'doughnut',
                data: {
                    labels: ['Pesquero', 'Carga', 'Turismo'],
                    datasets: [{
                        data: [40, 30, 50],
                        backgroundColor: ['#0d6efd', '#198754', '#ffc107']
                    }]
                }
            });

            // 📈 Gráfica 2
            new Chart(document.getElementById('chartMeses'), {
                type: 'line',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr'],
                    datasets: [{
                        label: 'Registros',
                        data: [10, 20, 15, 30],
                        borderColor: '#0d6efd',
                        fill: false
                    }]
                }
            });

            // 📋 Tabla
            $("#tablaEmbarcaciones").DataTable({
                data: [
                    ["Barco 1", "Pesquero", "Corinto", "2026-01-01"],
                    ["Barco 2", "Carga", "San Juan", "2026-02-01"]
                ]
            });

        });
    </script>
}
