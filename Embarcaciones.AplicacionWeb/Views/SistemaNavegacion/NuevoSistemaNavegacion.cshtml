@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.SistemaNavegacion;

@model SistemaNavegacionVM

@{
    ViewData["Title"] = "Gestion SistemaNavegacion";
    ViewBag.Accion = @Model.Accion;
}

@using (Html.BeginForm("GuardarSistemaNavegacion", "SistemaNavegacion", FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header">
                    <div class="d-flex justify-content-end">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">SIEB</li>
                                <li class="breadcrumb-item active" aria-current="page">Sistema Navegacion</li>
                                <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Sistema Navegacion</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card shadow-sm">
                                <div class="card-header text-white bg-primary">
                                    @ViewBag.Accion SistemaNavegacion
                                </div>
                                <div class="card-body">
                                    <div class="col-md-3">
                                        @Html.HiddenFor(x => x.IdCatalogo)
                                        @Html.HiddenFor(x => x.IdSistemaNavegacion)
                                        @Html.HiddenFor(x => x.Accion)
                                        <div class="form-group">
                                            <label class="mt-2">Sistema Navegacion::</label>
                                            <input asp-for="SistemaNavegacion" class="form-control" />
                                            <span asp-validation-for="SistemaNavegacion" class="text-danger mt-2 fw-bold"></span>
                                        </div>
                                        <div class="form-group">
                                            <label class="mt-2">Descripcion:</label>
                                            <input asp-for="Descripcion" class="form-control" />
                                        </div>
                                    </div>
                                    <button class="btn btn-success mt-4"><i class="fa fa-save"></i> Guardar</button>
                                    <a href="@Url.Action("Administrar", "SistemaNavegacion")"
                                       class="btn btn-danger mt-4">
                                        <i class="fa fa-times"></i> Cancelar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}


