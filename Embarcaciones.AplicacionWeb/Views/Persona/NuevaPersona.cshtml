@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.Persona;

@model PersonaVM

@{
    ViewData["Title"] = "Gestion Persona";
    ViewBag.Accion = Model.Accion;
}

@using (Html.BeginForm("GuardarPersona", "Persona", FormMethod.Post))
{
    <form>
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <div class="d-flex justify-content-end">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">SIEB</li>
                                    <li class="breadcrumb-item active" aria-current="page">Personas</li>
                                    <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Persona</li>
                                </ol>
                            </nav>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">


                                <div class="card shadow-sm">
                                    <div class="card-header text-white bg-primary">
                                        @ViewBag.Accion Persona
                                    </div>
                                    <div class="card-body">

                                        <div class="row">
                                            <div class="col-md-6">
                                                @Html.HiddenFor(x => x.Accion, new { @id = "hd-accion" })
                                                @Html.HiddenFor(x => x.IdPersona)
                                                <div class="form-group">
                                                    <label class="mt-2">NombreCompleto:</label>
                                                    <input asp-for="NombreCompleto" class="form-control" />
                                                    <span asp-validation-for="NombreCompleto" class="text-danger mt-2 fw-bold"></span>
                                                </div>
                                                <div class="form-group">
                                                    <label class="mt-2">Telefono:</label>
                                                    <input asp-for="Telefono" class="form-control" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="mt-2">Correo:</label>
                                                    <input asp-for="Correo" class="form-control" />
                                                </div>

                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Tipo Indentificacion:</label>
                                                    <select id="cmb-tipo-identificacion" asp-for="IdTipoIdentificacion" class="form-control" asp-items="Model.ListaTipoIdentificacion">
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="mt-2">Identificacion:</label>
                                                    <input asp-for="Identificacion" class="form-control" />
                                                </div>
                                                <div class="form-group">
                                                    <label class="mt-2">Direccion:</label>
                                                    <input asp-for="Direccion" class="form-control" />
                                                </div>
                                            </div>
                                        </div>

                                        <button class="btn btn-success mt-4"><i class="fa fa-save"></i> Guardar</button>
                                        <a href="@Url.Action("Administrar", "Persona")"
                                           class="btn btn-danger mt-4">
                                            <i class="fa fa-times"></i> Cancelar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            let accion = $("#hd-accion").val();
            // if (accion === "Nuevo") {
            //     $('#cmb-departamentos').val("");
            // }
            $('#cmb-tipo-identificacion').select2({
                placeholder: "Seleccione un Departamento",
                allowClear: true,
                width: '100%' // hace que ocupe todo el ancho del contenedor
            });
        });
    </script>
}