@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.Persona;

@model PersonaVM

@{
    ViewData["Title"] = "Gestion Persona";
    ViewBag.Accion = Model.Accion;
}

 @using (Html.BeginForm("GuardarPersona", "Persona", FormMethod.Post))
{
        <div class="card-body">
        <div class="card-header">
            <div class="d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">SIEB</li>
                        <li class="breadcrumb-item active" aria-current="page">Personas</li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Persona</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-12">


                    <div class="card">
                        <div class="card-header text-white bg-primary">
                            @ViewBag.Accion Persona
                        </div>
                        <div class="card-body">

                            <div class="row">
                                <div class="col-md-6">
                                    @Html.HiddenFor(x => x.Accion, new { @id = "hd-accion" })
                                    @Html.HiddenFor(x => x.IdPersona)
                                    <label>Nombre Completo::</label>
                                    <input type="text" class="form-control" asp-for="NombreCompleto" />                                
                                    <label>Telefono:</label>
                                    <input type="text" class="form-control" asp-for="Telefono" />
                                    <label>Correo:</label>
                                    <input type="text" class="form-control" asp-for="Correo" />

                                </div>
                                <div class="col-md-6">
                                    <label>Tipo Indentificacion:</label>
                                    <select id="cmb-tipo-identificacion" asp-for="IdTipoIdentificacion" class="form-control" asp-items="Model.ListaTipoIdentificacion">
                                        <option value=""></option>
                                    </select>                                                   
                                    <label>Identificacion:</label>
                                    <input type="text" class="form-control" asp-for="Identificacion" />
                                    <label>Direccion:</label>
                                    <input type="text" class="form-control" asp-for="Direccion" />
                                </div>
                            </div>

                            <button class="btn btn-success mt-4"><i class="fa fa-save"></i> Guardar</button>
                            <a href="@Url.Action("Administrar", "Persona")"
                               class="btn btn-danger mt-4">
                                <i class="fa fa-times"></i> Cancelar
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    
}

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            let accion = $("#hd-accion").val();
            // if (accion === "Nuevo") {
            //     $('#cmb-departamentos').val("");
            // }
            $('#cmb-tipo-identificacion').select2({
                placeholder: "Seleccione un Departamento",
                allowClear: true,
                width: '100%' // hace que ocupe todo el ancho del contenedor
            });
        });
    </script>
}