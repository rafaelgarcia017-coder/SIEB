@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.Persona;

@model AdministrarPersonasVM

@{
    ViewData["Title"] = "Administrar Personas";
}

<div class="card-body">
    <div class="card-header">
        <div class="d-flex justify-content-end">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">SIEB</li>
                    <li class="breadcrumb-item active" aria-current="page">Personas</li>
                    <li class="breadcrumb-item active" aria-current="page">Administrar</li>
                </ol>
            </nav>
        </div>
    </div>
    <div class="card-body">

        <div class="row">
            <div class="col-md-2">
                <a href="@Url.Action("NuevaPersona", "Persona")"
                   class="btn btn-success">
                    <i class="fa fa-plus"></i> Nuevo
                </a>

            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-12">
                <table class="table table-responsive table-bordered">
                    <thead>
                        <tr class="table-info">
                            <th>Datos Generales</th>
                            <th>Datos Especificos</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListaPersonas)
                        {
                            <tr>
                                <td>
                                    Nombre: <b>@item.NombreCompleto</b><br />
                                    Telefono :<b>@item.Telefono</b><br />
                                    Correo:<b>@item.Correo</b>
                                </td>
                                <td>
                                    Tipo Identificacion <b>@item.Identificacion</b><br />
                                    Identificacion: <b>@item.Identificacion</b><br />
                                    Direccion: <b>@item.Direccion</b> 
                                </td>
                                <td class="td-center">
                                    <a href="@Url.Action("EditarPersona", "Persona", new { id = item.IdPersona })" )"
                                       class="btn btn-primary btn-table">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <button class="btn btn-danger btn-table"><i class="fa fa-trash"></i></button>
                                </td>
                            </tr>


                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
