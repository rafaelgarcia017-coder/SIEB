@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.Color;

@model ColorVM

@{
    ViewData["Title"] = "Gestion Color";
    ViewBag.Accion = @Model.Accion;
}

@using (Html.BeginForm("GuardarColor", "Color", FormMethod.Post))
{
    <div class="card-body">
        <div class="card-header">
            <div class="d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">SIEB</li>
                        <li class="breadcrumb-item active" aria-current="page">Color</li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Color</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">


                    <div class="card">
                        <div class="card-header text-white bg-primary">
                            @ViewBag.Accion Color
                        </div>
                        <div class="card-body">
                            <div class="col-md-3">
                                @Html.HiddenFor(x => x.IdCatalogo)
                                @Html.HiddenFor(x => x.IdColor)
                                @Html.HiddenFor(x => x.Accion)
                                <label>Color:</label>
                                <input type="text" class="form-control" asp-for="Color" />
                                @Html.ValidationMessageFor(x => x.Color, "", new { @class = "text-danger" })
                                <label class="mt-2">Descripcion:</label>
                                <input type="text" class="form-control" asp-for="Descripcion" />
                            </div>
                            <button class="btn btn-success mt-4"><i class="fa fa-save"></i> Guardar</button>
                            <a href="@Url.Action("Administrar", "Color")"
                               class="btn btn-danger mt-4">
                                <i class="fa fa-times"></i> Cancelar
                            </a>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>

}


