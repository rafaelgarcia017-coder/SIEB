@using Embarcaciones.AplicacionWeb.Models.ViewModels.Catalogos.Bandera;

@model BanderaVM

@{
    ViewData["Title"] = "Gestion Banderas";
    ViewBag.Accion = Model.Accion;
}

@using (Html.BeginForm("GuardarBandera", "Bandera", FormMethod.Post))
{
    <div class="card-body">
        <div class="card-header">
            <div class="d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">SIEB</li>
                        <li class="breadcrumb-item active" aria-current="page">Banderas</li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Accion Bandera</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">


                    <div class="card">
                        <div class="card-header text-white bg-primary">
                            @ViewBag.Accion Bandera
                        </div>
                        <div class="card-body">
                            <div class="col-md-3">
                                @Html.HiddenFor(x => x.IdCatalogo)
                                @Html.HiddenFor(x => x.IdBandera)
                                @Html.HiddenFor(x => x.Accion)
                                <div class="form-group">
                                    <label class="mt-2">Bandera:</label>
                                    <input asp-for="Bandera" class="form-control" />
                                    <span asp-validation-for="Bandera" class="text-danger mt-2 fw-bold"></span>
                                </div>
                                <div class="form-group">
                                    <label class="mt-2">Descripcion:</label>
                                    <input asp-for="Descripcion" class="form-control" />
                                </div>
                            </div>
                            <button class="btn btn-success mt-4"><i class="fa fa-save"></i> Guardar</button>
                            <a href="@Url.Action("Administrar", "Bandera")"
                               class="btn btn-danger mt-4">
                                <i class="fa fa-times"></i> Cancelar
                            </a>

                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>

}


